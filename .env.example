# Required API keys
aiapi=your_gemini_api_key_here
newsapi=your_thenewsapi_key_here

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/geodigest

# JWT secret (any random string, at least 32 characters)
JWT_SECRET=change_me_to_a_random_secret_string_at_least_32_chars

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Optional
PORT=3000
